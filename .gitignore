# Real credentials — never commit these. Copy mail/mail-config.sample.php
# to mail/mail-config.php on the server and fill it in there. (Named
# "mail-config.php" rather than "config.php" because some hosts block/
# reserve that filename.)
/mail/mail-config.php

# Same pattern for the ConnectWise API credentials -- copy
# relationships/api/connectwise-config.sample.php to
# relationships/api/connectwise-config.php on the server and fill it in
# there.
/relationships/api/connectwise-config.php

# Common OS/editor cruft
.DS_Store
Thumbs.db
*.swp

# Relationships dashboard's runtime SQLite database — created on first
# request by relationships/api/db.php. Never commit it: it's live CRC
# accounts + customer/checklist data, not source, and a `git pull` deploy
# must never overwrite or wipe it.
/relationships/data/*.sqlite
/relationships/data/*.sqlite-wal
/relationships/data/*.sqlite-shm

# Same pattern for the Register app's ConnectWise API credentials -- copy
# register/api/connectwise-config.sample.php to
# register/api/connectwise-config.php on the server and fill it in there.
/register/api/connectwise-config.php

# Register app's runtime SQLite database + PHP session files -- created on
# first request by register/api/db.php / register/api/_util.php. Never
# commit these: they're live retail-staff accounts, synced catalog, and
# sale history, not source, and a `git pull` deploy must never overwrite or
# wipe them.
/register/data/*.sqlite
/register/data/*.sqlite-wal
/register/data/*.sqlite-shm
/register/data/sessions/
